{
  "name": "driftcheck",
  "version": "0.1.0",
  "description": "Keeps native Android and iOS apps in sync by comparing how each feature is implemented on both platforms.",
  "license": "MIT",
  "author": "David Olsson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidOlsson/driftcheck.git"
  },
  "type": "module",
  "bin": {
    "driftcheck": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.287",
    "@anthropic-ai/sdk": "^0.131.0",
    "commander": "^14.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
