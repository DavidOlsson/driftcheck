root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# IntelliJ's Kotlin style, which the code already follows, rather than ktlint's stricter default
ktlint_code_style = intellij_idea
max_line_length = 140

[*.{yml,yaml,json}]
indent_size = 2

[gradlew.bat]
end_of_line = crlf
